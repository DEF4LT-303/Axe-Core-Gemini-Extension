{
  "name": "axe-a11y-mcp",
  "version": "1.2.1",
  "description": "Axe-powered Accessibility Testing MCP Server and Gemini CLI Extension",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "axe-a11y": "./dist/index.js",
    "axe-a11y-mcp": "./dist/index.js"
  },
  "files": [
    "dist",
    "gemini-extension.json",
    "README.md",
    "GEMINI.md",
    "commands"
  ],
  "scripts": {
    "build": "node scripts/build.js",
    "watch": "tsc --watch",
    "start": "node dist/index.js",
    "test": "node scripts/build.js && node test/verify.js && node test/test-mcp.js",
    "version": "node scripts/sync-version.js && npm run build && git add gemini-extension.json dist/ browsers.json"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "gemini-cli",
    "axe-core",
    "accessibility",
    "a11y",
    "wcag",
    "playwright"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "@axe-core/playwright": "^4.10.1",
    "@modelcontextprotocol/sdk": "^1.6.1",
    "axe-core": "^4.10.2",
    "playwright": "^1.50.1",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/node": "^22.13.4",
    "esbuild": "^0.28.2",
    "typescript": "^5.7.3"
  }
}
